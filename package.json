{
  "name": "hirebeat-d1-schema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run schema:validate && npm run ingress:test && npm run orchestrator:test && npm run workers:build",
    "ingress:test": "npm --prefix workers/submission-ingress run test:unit",
    "orchestrator:test": "esbuild workers/etl-orchestrator/test/outbox-idempotency.test.ts --bundle --platform=node --format=esm --outfile=/tmp/hirebeat-outbox-idempotency-test.mjs && node /tmp/hirebeat-outbox-idempotency-test.mjs && rm -f /tmp/hirebeat-outbox-idempotency-test.mjs",
    "workers:build": "npm run ingress:build && npm run orchestrator:build && npm run operations:build",
    "ingress:build": "wrangler deploy --dry-run --config workers/submission-ingress/wrangler.toml",
    "orchestrator:build": "wrangler deploy --dry-run --config workers/etl-orchestrator/wrangler.toml",
    "operations:build": "wrangler deploy --dry-run --config workers/operations-api/wrangler.toml",
    "ingress:dev": "wrangler dev --config workers/submission-ingress/wrangler.toml",
    "ingress:deploy:staging": "wrangler deploy --config workers/submission-ingress/wrangler.toml",
    "orchestrator:deploy:staging": "wrangler deploy --config workers/etl-orchestrator/wrangler.toml",
    "operations:deploy:staging": "wrangler deploy --config workers/operations-api/wrangler.toml",
    "export:workflow": "python3 scripts/export_workflow_inspection.py",
    "schema:build": "python3 scripts/build_schema_artifacts.py",
    "schema:validate": "python3 scripts/validate_schema.py",
    "d1:migrations:list:local": "wrangler d1 migrations list DB --local",
    "d1:migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "d1:migrations:list:remote": "wrangler d1 migrations list DB --remote",
    "d1:migrations:apply:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
